{
  "name": "gaetanata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/dev.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/start.ts",
    "import:tables": "node --experimental-strip-types scripts/import-tables.ts",
    "export:food-review": "node --experimental-strip-types scripts/export-food-review.ts",
    "verify:template": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-template.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run check:imports && npm run check:public",
    "check:imports": "biome lint src server scripts --only=plugin",
    "check:public": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-public-boundary.ts",
    "smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify.ts",
    "prepare": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/install-hooks.ts"
  },
  "dependencies": {
    "docxtemplater": "3.71.1",
    "lodash": "4.18.1",
    "pizzip": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@xmldom/xmldom": "0.9.12",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
