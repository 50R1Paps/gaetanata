{
  "plugins": [
    {
      "path": "./scripts/no-promise.grit",
      "includes": ["src/**", "server/**", "scripts/**"]
    },
    {
      "path": "./scripts/no-dynamic-import.grit",
      "includes": ["src/**", "server/**", "scripts/**"]
    },
    {
      "path": "./scripts/native-imports.grit",
      "includes": ["server/**", "scripts/**"]
    },
    {
      "path": "./scripts/launcher-imports.grit",
      "includes": ["scripts/start.ts"]
    }
  ],
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "server/**",
      "*.json",
      "*.ts",
      "!!**/.worktrees"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
